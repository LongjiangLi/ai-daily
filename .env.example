# ===== LLM（DeepSeek 默认）=====
LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_REASONING_MODEL=deepseek-reasoner

# ===== 邮件（QQ 邮箱示例）=====
# QQ/163 用「授权码」，不是登录密码
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your@qq.com
SMTP_PASS=你的授权码
MAIL_FROM=your@qq.com
MAIL_TO=your@qq.com
# 多个收件人用英文逗号分隔

# ===== 可选：提升 GitHub API 限额（10/min -> 30/min）=====
# GITHUB_TOKEN=ghp_xxxxxxxx

# ===== 可选：HuggingFace 镜像 =====
# 国内直连 huggingface.co 通常不通，本机调试时启用；GitHub Actions 不需要
# HF_ENDPOINT=https://hf-mirror.com
